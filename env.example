# Clash of Clans API
COC_API_TOKEN=
COC_CLAN_TAG=#YOUR_CLAN_TAG

# Dedicated Supabase project for this bot/data layer
SUPABASE_URL=
# SERVER-SIDE ONLY: used by the sync scheduler and backend-only Discord AI state
SUPABASE_SERVICE_ROLE_KEY=
# READ-ONLY/AI: used for CoC data retrieval with RLS policies
SUPABASE_ANON_KEY=

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional: private channel for detailed AI provider/quota/API error alerts
PONYO_ALERT_CHANNEL_ID=
# Required for automatic Clan War / Capital Raid reports: channel ID of #data-report
PONYO_DATA_REPORT_CHANNEL_ID=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# =============================
# SYNC CONTROL
# =============================
ENABLE_SYNC_SCHEDULER=true
ENABLE_CLAN_SYNC=true
ENABLE_WAR_SYNC=true
ENABLE_HISTORY_SYNC=true
ENABLE_CAPITAL_SYNC=true
ENABLE_CWL_SYNC=true
ENABLE_PLAYER_SNAPSHOT_SYNC=true
ENABLE_EVENT_REPORTS=true

# Intervals in milliseconds
CLAN_POLL_MS=600000
WAR_POLL_MS=60000
HISTORY_POLL_MS=1800000
CAPITAL_POLL_MS=60000
CWL_POLL_MS=60000
PLAYER_POLL_MS=1800000
REPORT_POLL_MS=60000

# Wait after the event end before refreshing final data and publishing.
PONYO_REPORT_SETTLE_DELAY_MS=120000
# Matches the clan-report format (participants N/44). Update if clan roster size changes.
PONYO_REPORT_ROSTER_SIZE=44

# Startup sync controls
STARTUP_CLAN_SYNC=true
STARTUP_WAR_SYNC=true
STARTUP_HISTORY_SYNC=true
STARTUP_CAPITAL_SYNC=true
STARTUP_CWL_SYNC=true
STARTUP_PLAYER_SNAPSHOT_SYNC=true

WARLOG_PAGE_LIMIT=100
CAPITAL_PAGE_LIMIT=100
PORT=3000
SNAPSHOT_KEEP_BATCHES=12
