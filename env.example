# Clash of Clans API
COC_API_TOKEN=
COC_CLAN_TAG=#YOUR_CLAN_TAG

# Dedicated Supabase project for this bot/data layer
SUPABASE_URL=
# SERVER-SIDE ONLY: used by the sync scheduler and backend-only Discord AI state
SUPABASE_SERVICE_ROLE_KEY=
# READ-ONLY/AI: used for CoC data retrieval with RLS policies
SUPABASE_ANON_KEY=

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional: private channel for detailed AI provider/quota/API error alerts
PONYO_ALERT_CHANNEL_ID=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Gemini 3.8 is the default. /tell uses low thinking for faster answers and immediately falls back on transient failures.
GEMINI_MODEL=gemini-3.8-flash
# /ask uses Sarvam 105B with its larger context window.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# =============================
# SYNC CONTROL
# =============================
# Set ENABLE_SYNC_SCHEDULER=false to stop all recurring background syncs.
ENABLE_SYNC_SCHEDULER=true

# Enable/disable individual recurring jobs.
ENABLE_CLAN_SYNC=true
ENABLE_WAR_SYNC=true
ENABLE_HISTORY_SYNC=true
ENABLE_CAPITAL_SYNC=true
ENABLE_CWL_SYNC=true
ENABLE_PLAYER_SNAPSHOT_SYNC=true

# Recurring intervals in milliseconds. You can change these in Render at any time.
# 60000 = 1 minute | 300000 = 5 minutes | 600000 = 10 minutes | 1800000 = 30 minutes
CLAN_POLL_MS=600000
WAR_POLL_MS=60000
HISTORY_POLL_MS=1800000
CAPITAL_POLL_MS=60000
CWL_POLL_MS=60000
PLAYER_POLL_MS=1800000

# Startup sync controls. These run once when the service starts.
STARTUP_CLAN_SYNC=true
STARTUP_WAR_SYNC=true
STARTUP_HISTORY_SYNC=true
STARTUP_CAPITAL_SYNC=true
STARTUP_CWL_SYNC=true

# API history page sizes
WARLOG_PAGE_LIMIT=100
CAPITAL_PAGE_LIMIT=100

# Render/web server
PORT=3000
